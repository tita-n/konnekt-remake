// Konnekt data model — Phase 0.
// Every tenant-owned model carries universityId and is only reachable through
// the tenant-scoped client in src/lib/db/tenant.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UniversityStatus {
  WAITLIST
  ACTIVE
  OFF
}

enum AcademicNodeType {
  COLLEGE
  FACULTY
  DEPARTMENT
}

enum UserStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
  ALUMNI
  DELETED_PENDING
}

enum Role {
  PLATFORM_ADMIN
  UNIVERSITY_ADMIN
  REVIEWER
  MODERATOR
  OFFICIAL
}

enum VerificationMethod {
  STUDENT_EMAIL
  ID_CARD
  VOUCH
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DecisionReason {
  MATRIC_MISMATCH
  ID_UNREADABLE
  DUPLICATE_ACCOUNT
  NOT_A_STUDENT
  EXPIRED_DOCUMENT
  FAKE_DOCUMENT
  OTHER
}

enum EmailCodePurpose {
  SIGNUP_EMAIL
  STUDENT_EMAIL
  PASSWORD_RESET
}

enum WaitlistKind {
  UNIVERSITY
  STUDENT
}

enum Visibility {
  EVERYONE
  UNIVERSITY
  NOBODY
}

enum PostType {
  POST
  QUESTION
  POLL
  REPOST
}

enum AudienceKind {
  PUBLIC
  COLLEGE
  FACULTY
  DEPARTMENT
  LEVEL
}

enum PostStatus {
  ACTIVE
  REMOVED
  DELETED
}

enum CommentStatus {
  ACTIVE
  REMOVED
  DELETED
}

enum ReactionTargetType {
  POST
  COMMENT
}

enum MentionSourceType {
  POST
  COMMENT
}

enum ReportTargetType {
  POST
  COMMENT
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_OR_ABUSE
  NUDITY_OR_SEXUAL_CONTENT
  VIOLENCE_OR_THREATS
  IMPERSONATION
  FALSE_INFORMATION
  SOMETHING_ELSE
}

enum ReportStatus {
  PENDING
  RESOLVED
}

enum ModerationTargetType {
  POST
  COMMENT
  USER
}

enum ModerationActionType {
  REMOVE
  KEEP
  WARN
  SUSPEND
}

model University {
  id                  String           @id @default(cuid())
  name                String
  shortName           String
  slug                String           @unique
  logoUrl             String?
  accentColor         String           @default("#1B7F5A")
  status              UniversityStatus @default(WAITLIST)
  /// Layer labels, e.g. { "COLLEGE": "College", "FACULTY": "Faculty", "DEPARTMENT": "Department" }
  labels              Json             @default("{}")
  /// Phase-gated capabilities, e.g. { "campusVoice": false }
  featureFlags        Json             @default("{}")
  studentEmailDomains String[]         @default([])
  idCardEnabled       Boolean          @default(true)
  vouchingEnabled     Boolean          @default(false)
  matricPattern       String           @default("^\\d{2}/\\d{4,5}/\\d{3}$")
  /// Required consent version for this university's signup, e.g. "2026-01-01"
  policyVersion       String           @default("2026-01-01")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  academicNodes        AcademicNode[]
  users                User[]
  roleAssignments      RoleAssignment[]
  verificationRequests VerificationRequest[]
  auditLogs            AuditLog[]
  signupDrafts         SignupDraft[]
  roleInvites          RoleInvite[]

  @@index([status])
}

model AcademicNode {
  id           String           @id @default(cuid())
  universityId String
  parentId     String?
  type         AcademicNodeType
  name         String
  slug         String
  /// Materialized path of ancestor ids, root-first, slash separated, no trailing slash.
  /// "" for a root node; e.g. "college1/faculty1" for a department.
  path         String           @default("")
  sortOrder    Int              @default(0)
  isActive     Boolean          @default(true)
  /// Allowed levels for a department, e.g. [100,200,300,400,500,600]. Empty for non-departments.
  levels       Int[]            @default([])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  university University     @relation(fields: [universityId], references: [id], onDelete: Restrict)
  parent     AcademicNode?  @relation("AcademicTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   AcademicNode[] @relation("AcademicTree")
  users      User[]
  parentPath String         @default("") @map("parent_path")

  @@unique([universityId, parentPath, slug], map: "academic_node_unique_slug")
  @@index([universityId])
  @@index([universityId, path])
  @@index([universityId, parentId, sortOrder])
}

model User {
  id                   String     @id @default(cuid())
  universityId         String
  email                String     @unique
  emailVerified        Boolean    @default(false)
  username             String     @unique
  passwordHash         String
  fullName             String
  photoUrl             String?
  bio                  String?
  status               UserStatus @default(UNVERIFIED)
  matricNumber         String?
  matricNormalized     String?
  departmentNodeId     String?
  level                Int?
  isPostgraduate       Boolean    @default(false)
  interests            String[]   @default([])
  consentPolicyVersion String?
  consentAcceptedAt    DateTime?
  departmentVisibility Visibility @default(UNIVERSITY)
  levelVisibility      Visibility @default(UNIVERSITY)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  lastActiveAt         DateTime?
  verifiedAt           DateTime?
  deletedRequestedAt   DateTime?
  purgeAfter           DateTime?
  suspendedUntil       DateTime?
  flaggedForReviewAt   DateTime?

  university           University            @relation(fields: [universityId], references: [id], onDelete: Restrict)
  department           AcademicNode?         @relation(fields: [departmentNodeId], references: [id], onDelete: Restrict)
  roles                RoleAssignment[]
  sessions             Session[]
  emailCodes           EmailCode[]
  verificationRequests VerificationRequest[] @relation("Requester")
  vouchesGiven         VerificationRequest[] @relation("Voucher")
  reviewsGiven         VerificationRequest[] @relation("Reviewer")
  passwordResets       PasswordResetToken[]
  auditLogs            AuditLog[]
  posts                Post[]
  comments             Comment[]
  reactions            Reaction[]
  bookmarks            Bookmark[]
  drafts               Draft[]
  mutesGiven           Mute[]                @relation("Muter")
  mutesReceived        Mute[]                @relation("Muted")
  blocksGiven          Block[]               @relation("Blocker")
  blocksReceived       Block[]               @relation("Blocked")
  reportsMade          Report[]              @relation("Reporter")
  moderationActions    ModerationAction[]    @relation("Moderator")
  strikes              Strike[]
  mentions             Mention[]

  @@index([universityId])
  @@index([universityId, status])
  @@index([universityId, matricNormalized])
  @@index([universityId, departmentNodeId])
}

/// Pre-account signup state. A student may verify their student email or submit
/// an ID card before an account exists; the draft holds that proof (and only a
/// password *hash*) for at most 24 hours, then becomes a User atomically.
model SignupDraft {
  id                     String             @id @default(cuid())
  tokenHash              String             @unique
  universityId           String
  method                 VerificationMethod
  matricNumber           String?
  matricNormalized       String?
  idImageRef             String?
  vouchId                String?
  studentEmail           String?
  studentEmailVerifiedAt DateTime?
  pendingFullName        String?
  pendingUsername        String?
  pendingEmail           String?
  pendingPasswordHash    String?
  emailCodeSentAt        DateTime?
  createdAt              DateTime           @default(now())
  expiresAt              DateTime

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([expiresAt])
}

model RoleAssignment {
  id           String   @id @default(cuid())
  userId       String
  universityId String?
  role         Role
  grantedBy    String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([universityId, role])
}

/// Email invitation to hold a staff role. Tokens are single-use, hashed and
/// expire; accepting requires being signed in with the invited address.
model RoleInvite {
  id           String    @id @default(cuid())
  universityId String?
  email        String
  role         Role
  tokenHash    String    @unique
  invitedBy    String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  university University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([universityId])
}

model VerificationRequest {
  id               String             @id @default(cuid())
  userId           String
  universityId     String
  method           VerificationMethod
  matricNumber     String?
  matricNormalized String?
  /// Cloudinary private asset id. Wiped when the request is decided.
  idImageRef       String?
  status           VerificationStatus @default(PENDING)
  voucherId        String?
  reviewerId       String?
  decisionReason   DecisionReason?
  decisionNote     String?
  createdAt        DateTime           @default(now())
  decidedAt        DateTime?

  user       User       @relation("Requester", fields: [userId], references: [id], onDelete: Cascade)
  voucher    User?      @relation("Voucher", fields: [voucherId], references: [id], onDelete: SetNull)
  reviewer   User?      @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  university University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  @@index([universityId, status, createdAt])
  @@index([userId, status])
  @@index([voucherId, status])
  @@index([universityId, matricNormalized])
}

model EmailCode {
  id           String           @id @default(cuid())
  userId       String?
  universityId String?
  email        String
  purpose      EmailCodePurpose
  codeHash     String
  expiresAt    DateTime
  attempts     Int              @default(0)
  consumedAt   DateTime?
  createdAt    DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([universityId])
  @@index([userId, purpose])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
model Session {
  id           String    @id @default(cuid())
  userId       String
  universityId String?
  tokenHash    String    @unique
  userAgent    String?
  ipHash       String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  lastSeenAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([universityId])
}

model Post {
  id                String       @id @default(cuid())
  universityId      String
  authorId          String
  type              PostType     @default(POST)
  body              String       @db.Text
  /// Path prefix of the audience, or ["PUBLIC"] for the whole university.
  audiencePath      String[]     @default([])
  audienceKind      AudienceKind @default(PUBLIC)
  repostOfId        String?
  questionTitle     String?
  topicTag          String?
  acceptedCommentId String?      @unique
  status            PostStatus   @default(ACTIVE)
  /// Recency with a small narrower-audience boost; cursor pagination sorts on this.
  rankAt            DateTime     @default(now())
  editedAt          DateTime?
  removedAt         DateTime?
  moderationReason  String?
  /// Client-generated key so an offline retry can never create a duplicate.
  idempotencyKey    String?      @unique
  commentCount      Int          @default(0)
  reactionCount     Int          @default(0)
  repostCount       Int          @default(0)
  bookmarkCount     Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  repostOf        Post?          @relation("Reposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts         Post[]         @relation("Reposts")
  acceptedComment Comment?       @relation("AcceptedAnswer", fields: [acceptedCommentId], references: [id], onDelete: SetNull)
  media           PostMedia[]
  poll            Poll?
  comments        Comment[]
  revisions       PostRevision[]
  hashtags        PostHashtag[]

  @@index([universityId, status, rankAt, id])
  @@index([universityId, audienceKind, rankAt])
  @@index([universityId, authorId, createdAt])
  @@index([repostOfId])
  @@index([createdAt])
}

model PostRevision {
  id           String   @id @default(cuid())
  universityId String
  postId       String
  editorId     String
  body         String   @db.Text
  createdAt    DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([universityId, postId, createdAt])
}

model PostMedia {
  id           String  @id @default(cuid())
  universityId String
  postId       String
  publicId     String
  url          String?
  width        Int
  height       Int
  order        Int     @default(0)
  alt          String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([universityId, postId, order])
}

model Poll {
  id           String   @id @default(cuid())
  universityId String
  postId       String   @unique
  endsAt       DateTime
  createdAt    DateTime @default(now())

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([universityId, endsAt])
}

model PollOption {
  id           String @id @default(cuid())
  universityId String
  pollId       String
  text         String
  order        Int    @default(0)
  voteCount    Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([universityId, pollId, order])
}

model PollVote {
  id           String   @id @default(cuid())
  universityId String
  pollId       String
  optionId     String
  userId       String
  createdAt    DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId], map: "poll_vote_one_per_user")
  @@index([universityId, userId])
}

model Comment {
  id               String        @id @default(cuid())
  universityId     String
  postId           String
  authorId         String
  parentId         String?
  body             String        @db.Text
  status           CommentStatus @default(ACTIVE)
  helpfulCount     Int           @default(0)
  removedAt        DateTime?
  moderationReason String?
  editedAt         DateTime?
  createdAt        DateTime      @default(now())

  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("Replies")
  acceptedOn Post?     @relation("AcceptedAnswer")

  @@index([universityId, postId, parentId, status, createdAt])
  @@index([universityId, authorId, createdAt])
}

/// One kind only (heart); the row means "this user reacted to this target".
model Reaction {
  id           String             @id @default(cuid())
  universityId String
  userId       String
  targetType   ReactionTargetType
  targetId     String
  createdAt    DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, userId], map: "reaction_one_per_user")
  @@index([universityId, targetId])
  @@index([universityId, userId])
}

model Bookmark {
  id           String   @id @default(cuid())
  universityId String
  userId       String
  postId       String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId], map: "bookmark_one_per_user")
  @@index([universityId, userId, createdAt])
}

model Hashtag {
  id           String   @id @default(cuid())
  universityId String
  tag          String
  createdAt    DateTime @default(now())

  posts PostHashtag[]

  @@unique([universityId, tag])
  @@index([universityId, createdAt])
}

model PostHashtag {
  id           String @id @default(cuid())
  universityId String
  postId       String
  hashtagId    String

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([postId, hashtagId])
  @@index([universityId, hashtagId, postId])
}

model Mention {
  id              String            @id @default(cuid())
  universityId    String
  sourceType      MentionSourceType
  sourceId        String
  mentionedUserId String
  createdAt       DateTime          @default(now())

  mentionedUser User @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@index([universityId, mentionedUserId, createdAt])
  @@index([sourceType, sourceId])
}

/// One helpful mark per student per answer. Kept separate from hearts so a
/// helpful mark and a reaction can coexist without double counting.
model HelpfulMark {
  id           String   @id @default(cuid())
  universityId String
  commentId    String
  userId       String
  createdAt    DateTime @default(now())

  @@unique([commentId, userId], map: "helpful_one_per_user")
  @@index([universityId, commentId])
}

model Draft {
  id           String   @id @default(cuid())
  universityId String
  userId       String
  type         PostType @default(POST)
  payload      Json     @default("{}")
  audience     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([universityId, userId, updatedAt])
}

model Mute {
  id           String   @id @default(cuid())
  universityId String
  userId       String
  mutedUserId  String
  createdAt    DateTime @default(now())

  user      User @relation("Muter", fields: [userId], references: [id], onDelete: Cascade)
  mutedUser User @relation("Muted", fields: [mutedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, mutedUserId], map: "mute_one_per_user")
  @@index([universityId, mutedUserId])
}

model Block {
  id            String   @id @default(cuid())
  universityId  String
  userId        String
  blockedUserId String
  createdAt     DateTime @default(now())

  user        User @relation("Blocker", fields: [userId], references: [id], onDelete: Cascade)
  blockedUser User @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId], map: "block_one_per_user")
  @@index([universityId, blockedUserId])
}

model Report {
  id           String           @id @default(cuid())
  universityId String
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  reason       ReportReason
  details      String?          @db.Text
  status       ReportStatus     @default(PENDING)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime         @default(now())

  reporter User               @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  actions  ModerationAction[]

  @@unique([reporterId, targetType, targetId], map: "report_one_per_user")
  @@index([universityId, status, createdAt])
  @@index([universityId, targetType, targetId])
}

model ModerationAction {
  id           String               @id @default(cuid())
  universityId String
  reportId     String?
  moderatorId  String
  targetType   ModerationTargetType
  targetId     String
  action       ModerationActionType
  reason       String               @db.Text
  durationDays Int?
  createdAt    DateTime             @default(now())

  report    Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  moderator User    @relation("Moderator", fields: [moderatorId], references: [id], onDelete: Restrict)
  strike    Strike?

  @@index([universityId, createdAt])
  @@index([universityId, targetType, targetId])
  @@index([universityId, moderatorId, createdAt])
}

model Strike {
  id                 String   @id @default(cuid())
  universityId       String
  userId             String
  moderationActionId String   @unique
  createdAt          DateTime @default(now())
  expiresAt          DateTime

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  moderationAction ModerationAction @relation(fields: [moderationActionId], references: [id], onDelete: Cascade)

  @@index([universityId, userId, createdAt])
  @@index([universityId, expiresAt])
}

model WaitlistEntry {
  id             String       @id @default(cuid())
  kind           WaitlistKind
  universityName String?
  email          String
  createdAt      DateTime     @default(now())

  @@index([kind, createdAt])
  @@index([email])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  universityId String?
  action       String
  targetType   String
  targetId     String?
  metadata     Json     @default("{}")
  ipHash       String?
  createdAt    DateTime @default(now())

  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  university University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  @@index([universityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
