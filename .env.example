# ---------------------------------------------------------------------------
# Konnekt environment reference. Copy to .env.local and fill in.
# Only values prefixed NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Postgres (Neon: pooled connection string; DIRECT_URL is the unpooled one)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# Public origin, no trailing slash. Used for absolute links in email, CSP, and
# Turnstile domain checks.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# 32+ byte random secret: openssl rand -base64 48
AUTH_SECRET=""
# Session lifetime in days (default 30)
SESSION_TTL_DAYS="30"
# Set to "1" to accept the Turnstile test keys / bypass in local dev only.
TURNSTILE_BYPASS="0"

# Resend — transactional email
RESEND_API_KEY=""
EMAIL_FROM="Konnekt <hello@example.com>"
# Optional: send all mail to this address in staging (comma separated)
EMAIL_REDIRECT_TO=""

# Cloudinary — private delivery for ID card images
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Upstash Redis — sliding-window rate limits
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Sentry (optional in local dev; errors are still logged)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_AUTH_TOKEN=""

# Comma-separated platform-admin bootstrap emails. Only used by the seed script.
SEED_PLATFORM_ADMIN_EMAIL=""

# Shared secret for the scheduled-announcement cron endpoint. Unset means the
# endpoint stays closed; announcements still publish lazily when read.
ANNOUNCEMENT_CRON_SECRET=""
