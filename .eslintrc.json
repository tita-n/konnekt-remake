{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@/lib/db/platform",
            "message": "Tenant code must use tenantDb(universityId). The unscoped client is only for platform-admin APIs and infrastructure."
          }
        ]
      }
    ],
    "@typescript-eslint/no-unused-vars": "off"
  },
  "overrides": [
    {
      "files": [
        "src/lib/db/platform.ts",
        "src/lib/db/tenant.ts",
        "src/lib/auth/session.ts",
        "src/lib/audit.ts",
        "src/app/platform/**",
        "prisma/**",
        "tests/**",
        "e2e/**",
        "scripts/**",
        "src/app/api/dev/**"
      ],
      "rules": { "no-restricted-imports": "off" }
    }
  ]
}
