{
  "extends": [
    "next/core-web-vitals"
  ],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@/lib/db/platform",
            "message": "Tenant code must use tenantDb(universityId). The unscoped client is only for platform-admin APIs and infrastructure."
          }
        ]
      }
    ],
    "@typescript-eslint/no-unused-vars": "off"
  },
  "overrides": [
    {
      "files": [
        "src/lib/db/platform.ts",
        "src/lib/db/tenant.ts",
        "src/lib/auth/session.ts",
        "src/lib/audit.ts",
        "src/lib/services/**",
        "src/lib/media/**",
        "src/lib/email/**",
        "src/app/api/signup/**",
        "src/app/(auth)/signup/actions.ts",
        "src/app/(auth)/signup/[slug]/account/actions.ts",
        "src/app/api/dev/**",
        "src/app/platform/**",
        "prisma/**",
        "tests/**",
        "e2e/**",
        "scripts/**",
        "src/app/api/dev/**",
        "src/app/(auth)/**",
        "src/app/api/admin/**",
        "src/app/invite/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}